{
  "name": "groomdesk-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js"
  },
  "type": "module",
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
